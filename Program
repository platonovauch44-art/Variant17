import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        long X = sc.nextLong();

        long A = sc.nextLong();
        long B = sc.nextLong();
        long C = sc.nextLong();
        long D = sc.nextLong();

        long rA = A % X;
        long rB = B % X;
        long rC = C % X;
        long rD = D % X;

        long bestNumber = A;
        long bestRemainder = rA;

        if (rB < bestRemainder) {
            bestRemainder = rB;
            bestNumber = B;
        }
        if (rC < bestRemainder) {
            bestRemainder = rC;
            bestNumber = C;
        }
        if (rD < bestRemainder) {
            bestRemainder = rD;
            bestNumber = D;
        }

        System.out.println(bestNumber);
    }
}
